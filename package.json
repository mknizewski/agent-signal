{
  "name": "agent-signal",
  "version": "0.6.4",
  "description": "Minimal desktop dashboard for tracking Codex and Claude Code sessions.",
  "main": "dist-electron/electron/main.js",
  "author": "Agent Signal",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:main": "node scripts/clean-main-build.cjs && tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "dist": "pnpm run build && electron-builder --win nsis",
    "test": "vitest run --exclude \"dist-electron/**\"",
    "test:sync-smoke": "pnpm run build:main && node scripts/smoke-external-sessions.cjs",
    "test:mobile-smoke": "pnpm run build && node scripts/smoke-mobile-gateway.cjs",
    "test:app-smoke": "node scripts/smoke-packaged.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "lucide-react": "0.468.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.agentsignal.desktop",
    "productName": "Agent Signal",
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**/*"
    ],
    "files": [
      "build/icon.ico",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerLanguages": [
        "pl_PL",
        "en_US"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
